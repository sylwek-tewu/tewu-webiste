# ==============================================================================
# Biuro Rachunkowe TEWU - Environment Variables Example
# ==============================================================================
# Skopiuj ten plik jako .env.local podczas lokalnego developmentu.
# Na środowisku produkcyjnym (Coolify / Docker) skonfiguruj poniższe zmienne w panelu
# aplikacji w sekcji Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SMTP Email Configuration (Nodemailer) - Pełne dane zgłoszenia (w tym telefon)
# ------------------------------------------------------------------------------
CALLBACK_SMTP_HOST=smtp.twoj-serwer-poczty.pl
CALLBACK_SMTP_PORT=587
CALLBACK_SMTP_USER=powiadomienia@tewu.szczecin.pl
CALLBACK_SMTP_PASS=twoje-haslo-smtp
CALLBACK_FROM="Biuro Rachunkowe TEWU <powiadomienia@tewu.szczecin.pl>"
# Adresy odbiorców zgłoszeń w biurze (rozdzielane przecinkami)
CALLBACK_TO=biuro@tewu.szczecin.pl

# ------------------------------------------------------------------------------
# 2. Telegram Bot API - Powiadomienia techniczne (BEZ DANYCH OSOBOWYCH)
# ------------------------------------------------------------------------------
# Utwórz bota przez @BotFather na Telegramie, uzyskaj token, dodaj bota do grupy
# biura i odczytaj chat_id (dla grup ID zwykle zaczyna się od minusa, np. -100...).
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=-1001234567890

# ------------------------------------------------------------------------------
# 3. Zabezpieczenie zadania harmonogramu (Coolify Scheduled Task / Cron)
# ------------------------------------------------------------------------------
# Token uwierzytelniający żądania do wewnętrznego endpointu ponawiania bufora:
# POST /api/internal/process-outbox (nagłówek Authorization: Bearer <CRON_SECRET>).
# Wymagany na środowisku produkcyjnym.
CRON_SECRET=twoj-tajny-token-cron-generowany-losowo

# ------------------------------------------------------------------------------
# 4. Numer telefonu do szybkiego połączenia (Mobile "Zadzwoń")
# ------------------------------------------------------------------------------
# Format E.164: np. +48914824190 (stacjonarny) lub +48501482555 (komórkowy).
# Domyślnie (gdy puste lub niepoprawne): stacjonarny sekretariat +48914824190.
# UWAGA: Zmienna z prefiksem NEXT_PUBLIC_ jest wstrzykiwana podczas kompilacji (build time).
# Zmiana numeru w kontenerze wymaga ponownego zbudowania obrazu (rebuild).
NEXT_PUBLIC_CALLBACK_CALL_NUMBER=+48914824190

# ------------------------------------------------------------------------------
# 5. Bufor awaryjny (SQLite Outbox) & Bezpieczeństwo
# ------------------------------------------------------------------------------
# Ścieżka do pliku bazy SQLite. Domyślnie lokalnie: ./data/outbox.db; w obrazie Docker
# ustawiona na /app/data/outbox.db (katalog montowany jako Persistent Storage w Coolify).
# OUTBOX_DB_PATH=./data/outbox.db

# Czas retencji nieodebranych zgłoszeń w buforze awaryjnym (w godzinach). Domyślnie: 72.
# Wartość trafia też do treści polityki prywatności (podczas kompilacji) – zmiana wymaga ponownego buildu.
CALLBACK_OUTBOX_TTL_HOURS=72

# Klucz szyfrowania numerów telefonów w buforze awaryjnym (AES-256-GCM).
# Dowolny silny, losowy ciąg znaków (np. openssl rand -hex 32).
# WYMAGANY na produkcji: bez niego zgłoszenia nie trafią do bufora (klient zobaczy numer biura).
# Zmiana klucza sprawia, że oczekujące wpisy stają się nieczytelne – zostaną usunięte z alarmem na Telegram.
# Brak klucza w funkcji ponawiającej nie usuwa niczego: przebieg jest wstrzymany do czasu przywrócenia klucza (alarm na Telegram).
OUTBOX_ENCRYPTION_KEY=twoj-tajny-32-bajtowy-klucz-szyfrowania-aes

# ------------------------------------------------------------------------------
# 6. Dodatkowe dni wolne biura (NEXT_PUBLIC_EXTRA_CLOSED_DATES)
# ------------------------------------------------------------------------------
# Opcjonalna lista dat w formacie YYYY-MM-DD po przecinku (np. Sylwester, mostki).
# Wpływa na komunikat o terminie oddzwonienia i przycisk „Zadzwoń”, liczone w przeglądarce.
# UWAGA: zmienna jest wstrzykiwana podczas kompilacji – zmiana wymaga ponownego buildu.
# NEXT_PUBLIC_EXTRA_CLOSED_DATES=2026-12-31,2026-05-02
